<Window x:Class="HomelabControlCenter.CustomInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="DEVLABSTUDY // Input" Height="250" Width="420"
        WindowStartupLocation="CenterOwner" Background="#080C14" ResizeMode="NoResize" WindowStyle="None">

    <Border BorderBrush="#162032" BorderThickness="1" CornerRadius="8">
        <Grid Margin="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="/// " Foreground="#FF5500" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTitle" Text="Parametr komendy" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock x:Name="TxtPrompt" Text="Wprowadź docelowy adres IP lub domenę:" Foreground="#8A94A6" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <TextBox x:Name="TxtInput" Background="#101726" Foreground="White" Margin="0,0,0,20" Padding="10,8" KeyDown="TxtInput_KeyDown"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Content="Anuluj" Grid.Column="0" Appearance="Secondary" Margin="0,0,6,0" Click="BtnCancel_Click" Padding="0,8"/>
                    <ui:Button Content="Zatwierdź" Grid.Column="1" Appearance="Primary" Background="#FF5500" BorderBrush="#FF5500" Margin="6,0,0,0" Click="BtnOk_Click" Padding="0,8"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>