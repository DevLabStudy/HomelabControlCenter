<Window x:Class="HomelabControlCenter.AddServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Dodaj Serwer" Height="480" Width="440"
        Icon="devlab_icon.ico"
        WindowStartupLocation="CenterOwner" Background="#080C14" ResizeMode="NoResize">

    <Grid Margin="22">
        <StackPanel>
            <TextBlock Text="Dodaj Serwer" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,18"/>

            <TextBlock Text="Nazwa serwera (np. Proxmox, NAS):" Foreground="#8A94A6" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtServerName" Text="Proxmox VE" Background="#101726" Foreground="White" Margin="0,0,0,12" Padding="8,6"/>

            <TextBlock Text="Adres IP / Hostname:" Foreground="#8A94A6" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtServerIp" Text="192.168.1.100" Background="#101726" Foreground="White" Margin="0,0,0,12" Padding="8,6"/>

            <TextBlock Text="Użytkownik SSH:" Foreground="#8A94A6" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtServerUser" Text="root" Background="#101726" Foreground="White" Margin="0,0,0,12" Padding="8,6"/>

            <TextBlock Text="Hasło SSH:" Foreground="#8A94A6" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtServerPassword" Background="#101726" Foreground="White" Margin="0,0,0,12" Padding="8,6"/>

            <CheckBox x:Name="ChkRememberPassword" Content="Zapamiętaj hasło dla tego węzła" Foreground="#00A3FF" IsChecked="True" Margin="0,4,0,22"/>

            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:Button Content="Anuluj" Grid.Column="0" Appearance="Secondary" HorizontalAlignment="Stretch" Click="BtnCancel_Click" Padding="0,10"/>
                <ui:Button Content="Zapisz Serwer" Grid.Column="2" Appearance="Primary" Background="#FF5500" BorderBrush="#FF5500" HorizontalAlignment="Stretch" Click="BtnSave_Click" Padding="0,10"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>